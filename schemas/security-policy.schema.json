{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema-version", "policy-version", "blocking", "secret-patterns"],
  "properties": {
    "schema-version": {"const": "bcgov-marketplace-security-policy/v1alpha1"},
    "policy-version": {"type": "integer", "minimum": 1},
    "secret-patterns": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "blocking": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
