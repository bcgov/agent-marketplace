{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bcgov/agent-marketplace/schemas/bcgov-extension-v1alpha1.schema.json",
  "title": "BC Gov Agent Marketplace Extension",
  "description": "Author-controlled metadata for a hosted BC Gov Agent Skill.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema-version",
    "id",
    "display-name",
    "summary",
    "publisher",
    "maintainers",
    "support",
    "license",
    "lifecycle",
    "prerequisites",
    "capabilities"
  ],
  "properties": {
    "schema-version": {
      "const": "bcgov-extension/v1alpha1"
    },
    "id": {
      "type": "string",
      "pattern": "^bcgov-public/[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "display-name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280
    },
    "publisher": {
      "const": "Province of British Columbia"
    },
    "maintainers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^@[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?(?:/[A-Za-z0-9_.-]+)?$"
      }
    },
    "support": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "license": {
      "const": "Apache-2.0"
    },
    "lifecycle": {
      "enum": ["active", "quarantined", "removed"]
    },
    "prerequisites": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "capabilities": {
      "$ref": "#/$defs/capabilities"
    }
  },
  "$defs": {
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filesystem",
        "network",
        "commands",
        "environment-variables",
        "secret-names",
        "data-classes"
      ],
      "properties": {
        "filesystem": {
          "type": "object",
          "additionalProperties": false,
          "required": ["read", "write"],
          "properties": {
            "read": { "$ref": "#/$defs/stringSet" },
            "write": { "$ref": "#/$defs/stringSet" }
          }
        },
        "network": { "$ref": "#/$defs/stringSet" },
        "commands": { "$ref": "#/$defs/stringSet" },
        "environment-variables": { "$ref": "#/$defs/stringSet" },
        "secret-names": { "$ref": "#/$defs/stringSet" },
        "data-classes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]
          }
        }
      }
    }
  }
}