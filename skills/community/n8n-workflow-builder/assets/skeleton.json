{
  "connections": {
    "Collect": {
      "main": [
        [
          {
            "index": 0,
            "node": "Merge snippets",
            "type": "main"
          }
        ]
      ]
    },
    "Merge snippets": {
      "main": [
        [
          {
            "index": 0,
            "node": "Report",
            "type": "main"
          }
        ]
      ]
    },
    "Report": {
      "main": [
        [
          {
            "index": 0,
            "node": "Respond to Webhook (text)",
            "type": "main"
          }
        ]
      ]
    },
    "Webhook": {
      "main": [
        [
          {
            "index": 0,
            "node": "Collect",
            "type": "main"
          }
        ]
      ]
    }
  },
  "name": "triage-skeleton",
  "nodes": [
    {
      "id": "note-prod-url",
      "name": "Production URL",
      "parameters": {
        "color": 4,
        "content": "## INCOMPLETE SCAFFOLD - author review required\n\nReplace all REVIEWED_ placeholders with fixed reviewed literals before target-version validation. Not import-ready or runtime-tested.\n\nTrigger URL: <BASE_URL>/webhook/<PATH>\n\nWebhook request data must not select commands, namespaces, scripts, groups or reports.",
        "height": 240,
        "width": 380
      },
      "position": [
        180,
        60
      ],
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1
    },
    {
      "id": "webhook",
      "name": "Webhook",
      "parameters": {
        "httpMethod": "GET",
        "options": {},
        "path": "triage",
        "responseMode": "responseNode"
      },
      "position": [
        260,
        320
      ],
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "webhookId": "webhook"
    },
    {
      "id": "step-1",
      "name": "Collect",
      "notes": "What this collection snippet fetches.",
      "parameters": {
        "command": "NAMESPACE=REVIEWED_NAMESPACE REVIEWED_SNIPPET.sh"
      },
      "position": [
        480,
        320
      ],
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1
    },
    {
      "id": "merge-snippets",
      "name": "Merge snippets",
      "notes": "Flat-merge the collection snippets \u2014 one `export MERGE_<KEY>=...` line per collect node.",
      "parameters": {
        "command": "=export MERGE_ONE={{ $('Collect').item.json.stdout.base64Encode() }}\nmerge.sh --b64"
      },
      "position": [
        720,
        320
      ],
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1
    },
    {
      "id": "report",
      "name": "Report",
      "notes": "report.sh assembles merged + {validations} and renders the report markdown. With validators, add a 'Merge validations' node (merge.sh -k --b64) and `export VALS={{ $('Merge validations')...base64Encode() }}` here.",
      "parameters": {
        "command": "=export DATA={{ $('Merge snippets').item.json.stdout.base64Encode() }}\nexport NAMESPACE=REVIEWED_NAMESPACE\nreport.sh REVIEWED_GROUP REVIEWED_REPORT.md"
      },
      "position": [
        960,
        320
      ],
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1
    },
    {
      "id": "respond",
      "name": "Respond to Webhook (text)",
      "parameters": {
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/plain; charset=utf-8"
              }
            ]
          }
        },
        "respondWith": "text",
        "responseBody": "={{ $('Report').item.json.stdout }}"
      },
      "position": [
        1440,
        320
      ],
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1
    }
  ],
  "settings": {
    "executionOrder": "v1"
  }
}
